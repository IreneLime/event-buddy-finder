# Copy this file to the repository root as .env. Keep the completed .env private.
# Docker Compose runs the app and PostgreSQL locally, using real Firebase Auth
# and DigitalOcean Spaces. For host-based development, these use localhost ports.
VITE_EVENTS_API_URL=http://localhost:4001
VITE_CHAT_API_URL=http://localhost:4002
VITE_USERS_API_URL=http://localhost:4004
VITE_IMAGE_API_URL=http://localhost:4005

# Firebase Web application (public client settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_USE_FIREBASE_AUTH_EMULATOR=false
# Used only when the emulator flag above is true, such as in isolated E2E tests.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_EMAIL_VERIFICATION_CONTINUE_URL=http://localhost:5173/verify-email
LIVE_FIREBASE_API_KEY=

# Firebase Admin service account JSON, kept outside Git.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin.json
FIREBASE_CHECK_REVOKED_TOKENS=false

# Shared backend configuration. Compose overrides the container database URL.
WEB_ORIGIN=http://localhost:5173
AUTH_API_URL=http://localhost:4003
AUTH_API_TIMEOUT_MS=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_buddy_finder
NODE_ENV=development
CHAT_DEV_MODE=false
HOST=127.0.0.1

# DigitalOcean Spaces
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
SPACES_REGION=us-east-1
SPACES_FORCE_PATH_STYLE=false
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_DOWNLOAD_URL_EXPIRES_IN_SECONDS=900
