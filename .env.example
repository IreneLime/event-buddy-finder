# Copy this file to the repository-root `.env`. All frontend and backend
# services load this one file. Never commit the completed `.env`.

# Frontend service origins
VITE_EVENTS_API_URL=http://localhost:4001
VITE_CHAT_API_URL=http://localhost:4002
VITE_IMAGE_API_URL=http://localhost:4005
VITE_USERS_API_URL=http://localhost:4004

# Firebase Web application (client-side identifiers, not Admin credentials)
VITE_FIREBASE_API_KEY=<FIREBASE_WEB_API_KEY>
VITE_FIREBASE_AUTH_DOMAIN=event-buddy-finder-a65d5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=event-buddy-finder-a65d5
VITE_FIREBASE_APP_ID=<FIREBASE_WEB_APP_ID>
VITE_USE_FIREBASE_AUTH_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_EMAIL_VERIFICATION_CONTINUE_URL=http://localhost:5173/verify-email

# Shared backend configuration
WEB_ORIGIN=http://localhost:5173
AUTH_API_URL=http://localhost:4003
AUTH_API_TIMEOUT_MS=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_buddy_finder
NODE_ENV=development

# Firebase Admin. Copy the downloaded JSON to the repository root using the
# ignored filename `firebase-admin.json`, then use its absolute path here.
FIREBASE_PROJECT_ID=event-buddy-finder-a65d5
GOOGLE_APPLICATION_CREDENTIALS=<ABSOLUTE_REPOSITORY_PATH>/firebase-admin.json
FIREBASE_CHECK_REVOKED_TOKENS=false

# Real chat authentication through auth-api. Set true only for demo-user mode.
CHAT_DEV_MODE=false
HOST=127.0.0.1

# DigitalOcean Spaces
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
SPACES_REGION=us-east-1
SPACES_FORCE_PATH_STYLE=false
SPACES_BUCKET=event-buddy-finder-media-ece1724
SPACES_ACCESS_KEY_ID=<DIGITALOCEAN_SPACES_ACCESS_KEY_ID>
SPACES_SECRET_ACCESS_KEY=<DIGITALOCEAN_SPACES_SECRET_ACCESS_KEY>
SPACES_DOWNLOAD_URL_EXPIRES_IN_SECONDS=900
