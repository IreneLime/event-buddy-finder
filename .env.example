# Optional local service origins for the frontend when API integration begins.
VITE_EVENTS_API_URL=http://localhost:4001
VITE_CHAT_API_URL=http://localhost:4002
VITE_IMAGE_API_URL=http://localhost:4005
VITE_USERS_API_URL=http://localhost:4004

# user-api calls auth-api to validate Firebase Bearer tokens.
AUTH_API_URL=http://localhost:4003

# Auth/profile service. Firebase Admin credentials are documented in
# services/auth-api/.env.example and must remain server-side.
WEB_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=event-buddy-finder-a65d5
FIREBASE_CHECK_REVOKED_TOKENS=false

# events-api
PORT=4001
WEB_ORIGIN=http://localhost:5173
# Opt-in local-only auth bypass (Bearer dev:<uid>). Ignored in production and when FIREBASE_PROJECT_ID is set.
# ALLOW_DEV_AUTH=true
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Reserved for later PostgreSQL / DigitalOcean Spaces integration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_buddy_finder
SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
# DigitalOcean's S3-compatible signing region; the bucket location is in the endpoint.
SPACES_REGION=us-east-1
SPACES_BUCKET=event-buddy-finder-media-ece1724
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_DOWNLOAD_URL_EXPIRES_IN_SECONDS=900
