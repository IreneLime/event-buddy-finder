# Optional local service origins for the frontend when API integration begins.
VITE_EVENTS_API_URL=http://localhost:4001
VITE_CHAT_API_URL=http://localhost:4002

# Auth/profile service. Firebase Admin credentials are documented in
# services/auth-api/.env.example and must remain server-side.
WEB_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=event-buddy-finder-a65d5
FIREBASE_CHECK_REVOKED_TOKENS=false

# Reserved for later PostgreSQL / DigitalOcean Spaces integration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_buddy_finder
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
