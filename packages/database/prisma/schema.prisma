generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The SQL migrations remain authoritative for CHECK constraints and partial indexes.
model AppUser {
  firebaseUid                String         @id @map("firebase_uid")
  email                      String         @unique
  displayName                String         @map("display_name")
  ageRange                   String?        @map("age_range")
  affiliation                String?
  bio                        String?
  profileImageKey            String?        @map("profile_image_key")
  profileCompletedAt         DateTime?      @map("profile_completed_at") @db.Timestamptz(6)
  preferredCategories        String[]       @default([]) @map("preferred_categories")
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdEvents              Event[]        @relation("EventCreator")
  participations             EventParticipation[]
  messages                   Message[]      @relation("MessageSender")
  notificationsReceived      Notification[] @relation("NotificationRecipient")
  notificationsSent          Notification[] @relation("NotificationActor")
  conversationsAsParticipantOne Conversation[] @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo Conversation[] @relation("ConversationParticipantTwo")

  @@index([preferredCategories], type: Gin, map: "app_users_preferred_categories_gin_idx")
  @@map("app_users")
}

model Event {
  id                 BigInt                @id @default(autoincrement())
  publicId           String?               @unique @map("public_id")
  createdByUserId    String                @map("created_by_user_id")
  title              String
  description        String
  notes              String?
  startsAt           DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime?             @map("ends_at") @db.Timestamptz(6)
  locationName       String                @map("location_name")
  city               String                @default("Toronto")
  address            String?
  latitude           Decimal?              @db.Decimal(9, 6)
  longitude          Decimal?              @db.Decimal(9, 6)
  priceAmount        Decimal?              @map("price_amount") @db.Decimal(10, 2)
  capacity           Int?
  imageObjectKey     String?               @map("image_object_key")
  status             String                @default("scheduled")
  cancelledAt        DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  categoryNames      String[]              @default([]) @map("category_names")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          AppUser               @relation("EventCreator", fields: [createdByUserId], references: [firebaseUid], onDelete: Restrict)
  participations     EventParticipation[]
  conversation       Conversation?
  notifications      Notification[]

  @@index([startsAt], map: "events_starts_at_idx")
  @@index([status, locationName, startsAt], map: "events_status_location_idx")
  @@index([createdByUserId, createdAt(sort: Desc)], map: "events_creator_idx")
  @@index([city, status, startsAt], map: "events_city_status_starts_at_idx")
  @@index([categoryNames], type: Gin, map: "events_category_names_gin_idx")
  @@map("events")
}

model EventParticipation {
  eventId   BigInt   @map("event_id")
  userId    String   @map("user_id")
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      AppUser  @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId, status, eventId])
  @@index([eventId, status])
  @@map("event_participations")
}

model Conversation {
  id                     BigInt   @id @default(autoincrement())
  kind                   String
  eventId                BigInt?  @unique(map: "conversations_one_event_chat_idx") @map("event_id")
  participantOneUserId   String?  @map("participant_one_user_id")
  participantTwoUserId   String?  @map("participant_two_user_id")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event                  Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantOne         AppUser? @relation("ConversationParticipantOne", fields: [participantOneUserId], references: [firebaseUid], onDelete: Cascade)
  participantTwo         AppUser? @relation("ConversationParticipantTwo", fields: [participantTwoUserId], references: [firebaseUid], onDelete: Cascade)
  messages               Message[]

  @@map("conversations")
}

model Message {
  id             BigInt       @id @default(autoincrement())
  conversationId BigInt       @map("conversation_id")
  senderUserId   String       @map("sender_user_id")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         AppUser      @relation("MessageSender", fields: [senderUserId], references: [firebaseUid], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)], map: "messages_conversation_time_idx")
  @@map("messages")
}

model Notification {
  id               BigInt    @id @default(autoincrement())
  recipientUserId  String    @map("recipient_user_id")
  actorUserId      String?   @map("actor_user_id")
  eventId          BigInt?   @map("event_id")
  kind             String
  message          String
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt           DateTime? @map("read_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  recipient        AppUser   @relation("NotificationRecipient", fields: [recipientUserId], references: [firebaseUid], onDelete: Cascade)
  actor            AppUser?  @relation("NotificationActor", fields: [actorUserId], references: [firebaseUid], onDelete: SetNull)
  event            Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_inbox_idx")
  @@index([recipientUserId, createdAt(sort: Desc)], map: "notifications_unread_idx")
  @@map("notifications")
}
