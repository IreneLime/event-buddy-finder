%%{init: {"er": {"fontSize": 11}}}%%
erDiagram
    direction LR
    APP_USERS ||--o{ EVENTS : creates
    APP_USERS ||--o{ EVENT_PARTICIPATIONS : participates
    EVENTS ||--o{ EVENT_PARTICIPATIONS : has
    EVENTS |o--o| CONVERSATIONS : "optionally has event chat"
    APP_USERS |o--o{ CONVERSATIONS : "direct chat participant"
    CONVERSATIONS ||--o{ MESSAGES : has
    APP_USERS ||--o{ MESSAGES : sends
    APP_USERS ||--o{ NOTIFICATIONS : receives
    EVENTS |o--o{ NOTIFICATIONS : concerns

    APP_USERS {
        string firebase_uid PK
        string email UK
        string display_name
        string age_range
        string affiliation
        string bio
        string profile_image_key
        timestamp profile_completed_at
        string_array preferred_categories
        timestamp created_at
        timestamp updated_at
    }

    EVENTS {
        bigint id PK
        string public_id UK
        string created_by_user_id FK
        string title
        string description
        string notes
        timestamp starts_at
        timestamp ends_at
        string location_name
        string city
        string address
        decimal latitude
        decimal longitude
        decimal price_amount
        int capacity
        string image_object_key
        string status
        timestamp cancelled_at
        string_array category_names
        timestamp created_at
        timestamp updated_at
    }

    EVENT_PARTICIPATIONS {
        bigint event_id PK, FK
        string user_id PK, FK
        string status
        timestamp created_at
        timestamp updated_at
    }

    CONVERSATIONS {
        bigint id PK
        string kind
        bigint event_id FK "nullable, unique"
        string participant_one_user_id FK "nullable"
        string participant_two_user_id FK "nullable"
        timestamp created_at
    }

    MESSAGES {
        bigint id PK
        bigint conversation_id FK
        string sender_user_id FK
        string body
        timestamp created_at
    }

    NOTIFICATIONS {
        bigint id PK
        string recipient_user_id FK
        string actor_user_id FK "nullable"
        bigint event_id FK "nullable"
        string kind
        string message
        timestamp created_at
        timestamp read_at
        timestamp published_at
    }
