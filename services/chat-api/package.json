{
  "name": "@event-buddy/chat-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CHAT_DEV_MODE=${CHAT_DEV_MODE:-true} tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:membership": "REQUIRE_EVENT_MEMBERSHIP_TESTS=true tsx --test tests/event-membership.test.ts"
  },
  "dependencies": {
    "@event-buddy/contracts": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "tsx": "^4.20.6",
    "socket.io-client": "^4.8.1",
    "typescript": "~7.0.2",
    "@types/pg": "^8.23.1"
  }
}
