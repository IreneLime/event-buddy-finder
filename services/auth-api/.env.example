PORT=4003
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_buddy_finder
FIREBASE_PROJECT_ID=event-buddy-finder-a65d5

# Local development can use Application Default Credentials by pointing this
# variable at a service-account JSON file stored outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# A deployment platform can instead inject the full service-account JSON as a
# secret environment value. Never commit this value.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# These two variables match the events service deployment format and can be
# used instead of GOOGLE_APPLICATION_CREDENTIALS or FIREBASE_SERVICE_ACCOUNT_JSON.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@event-buddy-finder-a65d5.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Emulator-only value; omit the URL scheme.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional: checking revocation adds a Firebase lookup to each verification.
FIREBASE_CHECK_REVOKED_TOKENS=false
